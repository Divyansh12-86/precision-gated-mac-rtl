# =============================================================================
# Yosys Like-For-Like Multi-Mode Synthesis Script
# Target: Xilinx 7-Series xc7 family generic (no part-specific data)
# =============================================================================

# 1. Baseline FIR — LUT Mode (-nodsp, Out-Of-Context)
log "SYNTH_SECTION: baseline_fir_lut"
design -reset
read_verilog -sv rtl/baseline_fir_exact.v rtl/fir_coeff_rom.v rtl/sample_delay_line.v
hierarchy -check -top baseline_fir_exact
synth_xilinx -top baseline_fir_exact -family xc7 -nodsp -noiopad
stat -tech xilinx

# 2. Precision-Gated Top — LUT Mode (-nodsp, Out-Of-Context)
log "SYNTH_SECTION: pg_top_lut"
design -reset
read_verilog -sv rtl/pg_top.v rtl/pg_fir.v rtl/pg_mac.v rtl/mult_split.v rtl/sample_delay_line.v rtl/fir_coeff_rom.v rtl/qrs_detector.v
hierarchy -check -top pg_top
synth_xilinx -top pg_top -family xc7 -nodsp -noiopad
stat -tech xilinx

# 3. QRS Detector Alone — LUT Mode (-nodsp, Out-Of-Context)
log "SYNTH_SECTION: qrs_detector_lut"
design -reset
read_verilog -sv rtl/qrs_detector.v
hierarchy -check -top qrs_detector
synth_xilinx -top qrs_detector -family xc7 -nodsp -noiopad
stat -tech xilinx

# 4. Baseline FIR — DSP Mode (Default, Out-Of-Context)
log "SYNTH_SECTION: baseline_fir_dsp"
design -reset
read_verilog -sv rtl/baseline_fir_exact.v rtl/fir_coeff_rom.v rtl/sample_delay_line.v
hierarchy -check -top baseline_fir_exact
synth_xilinx -top baseline_fir_exact -family xc7 -noiopad
stat -tech xilinx

# 5. Precision-Gated Top — DSP Mode (Default, Out-Of-Context)
log "SYNTH_SECTION: pg_top_dsp"
design -reset
read_verilog -sv rtl/pg_top.v rtl/pg_fir.v rtl/pg_mac.v rtl/mult_split.v rtl/sample_delay_line.v rtl/fir_coeff_rom.v rtl/qrs_detector.v
hierarchy -check -top pg_top
synth_xilinx -top pg_top -family xc7 -noiopad
stat -tech xilinx

# 6. Board Demo Wrapper — Basys 3 (DSP Mode)
log "SYNTH_SECTION: top_basys3"
design -reset
read_verilog -sv fpga/top_basys3.v fpga/board_core.v fpga/uart_tx.v rtl/pg_top.v rtl/pg_fir.v rtl/pg_mac.v rtl/mult_split.v rtl/sample_delay_line.v rtl/fir_coeff_rom.v rtl/qrs_detector.v rtl/sample_tick_gen.v
hierarchy -check -top top_basys3
synth_xilinx -top top_basys3 -family xc7 -noiopad
stat -tech xilinx

# 7. Board Demo Wrapper — Nexys A7 (DSP Mode)
log "SYNTH_SECTION: top_nexys_a7"
design -reset
read_verilog -sv fpga/top_nexys_a7.v fpga/board_core.v fpga/uart_tx.v rtl/pg_top.v rtl/pg_fir.v rtl/pg_mac.v rtl/mult_split.v rtl/sample_delay_line.v rtl/fir_coeff_rom.v rtl/qrs_detector.v rtl/sample_tick_gen.v
hierarchy -check -top top_nexys_a7
synth_xilinx -top top_nexys_a7 -family xc7 -noiopad
stat -tech xilinx

# 8. Board Demo Wrapper — Basys 3 (LUT Mode, -nodsp)
log "SYNTH_SECTION: top_basys3_lut"
design -reset
read_verilog -sv fpga/top_basys3.v fpga/board_core.v fpga/uart_tx.v rtl/pg_top.v rtl/pg_fir.v rtl/pg_mac.v rtl/mult_split.v rtl/sample_delay_line.v rtl/fir_coeff_rom.v rtl/qrs_detector.v rtl/sample_tick_gen.v
hierarchy -check -top top_basys3
synth_xilinx -top top_basys3 -family xc7 -nodsp -noiopad
stat -tech xilinx

# 9. Board Demo Wrapper — Nexys A7 (LUT Mode, -nodsp)
log "SYNTH_SECTION: top_nexys_a7_lut"
design -reset
read_verilog -sv fpga/top_nexys_a7.v fpga/board_core.v fpga/uart_tx.v rtl/pg_top.v rtl/pg_fir.v rtl/pg_mac.v rtl/mult_split.v rtl/sample_delay_line.v rtl/fir_coeff_rom.v rtl/qrs_detector.v rtl/sample_tick_gen.v
hierarchy -check -top top_nexys_a7
